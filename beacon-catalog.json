      "documentation": "network/critical-open-ports.md",
      "mappings": {
        "mitreAttack": [
          { "id": "T1190", "name": "Exploit Public-Facing Application" },
          { "id": "T1133", "name": "External Remote Services" },
          { "id": "T1110", "name": "Brute Force" }
        ],
        "cwe": [{ "id": "CWE-284", "name": "Improper Access Control" }],
        "compliance": [
          { "framework": "PCI DSS v4.0", "control": "1.4.2" },
          { "framework": "ISO/IEC 27001:2022", "control": "A.8.20" },
          { "framework": "NIST CSF 2.0", "control": "PR.AA-05" },
          { "framework": "SOC 2", "control": "CC6.6" }
