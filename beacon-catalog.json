{
  "name": "Beacon Security Standards",
  "version": "1.1.0",
  "description": "Open framework for categorizing and prioritizing cybersecurity findings. Three tiers, four domains, one decision procedure.",
  "license": "GPL-3.0",
  "licenseUrl": "https://www.gnu.org/licenses/gpl-3.0.en.html",
  "publisher": "Penti.ai",
  "repository": "https://github.com/securily/beacon",
  "homepage": "https://beaconstandards.com",
  "identifierFormat": {
    "pattern": "BCN-T{tier}-{DOMAIN}-{sequence}",
    "example": "BCN-T1-NET-001",
    "stability": "Identifiers are permanent. A finding class may be reworded, re-mapped, or superseded, but its identifier is never reused or renumbered."
  },

  "tiers": [
    {
      "id": 1,
      "code": "T1",
      "name": "Critical",
      "sla": "24-72 hours",
      "slaHours": 72,
      "escalation": "CISO and executive sponsor notified at 48 hours",
      "intent": "Stop active bleeding",
      "test": "Could an external attacker use this to gain access, escalate privilege, or take data today, without an insider and without a chain of unlikely events?",
      "cvssGuide": "7.0-10.0, but exploitation evidence outranks score",
      "budgetedFrom": "Unplanned work - pre-empts sprint commitments",
      "documentation": "tiers/tier-1-critical-threat-management.md"
    },
    {
      "id": 2,
      "code": "T2",
      "name": "Regulatory",
      "sla": "30 days",
      "slaHours": 720,
      "escalation": "Security manager review at 14 days",
      "intent": "Maintain the license to operate",
      "test": "Would a named auditor, regulator, or contractual counterparty record this as a deficiency?",
      "cvssGuide": "4.0-6.9, or any score where a control is mandated",
      "budgetedFrom": "Planned work - scheduled against the audit calendar",
      "documentation": "tiers/tier-2-regulatory.md"
    },
    {
      "id": 3,
      "code": "T3",
      "name": "Best Practices",
      "sla": "90 days",
      "slaHours": 2160,
      "escalation": "Reviewed at quarterly planning; may be formally deferred",
      "intent": "Reduce the rate at which the first two tiers refill",
      "test": "Does fixing this reduce the number or severity of future Tier 1 and Tier 2 findings?",
      "cvssGuide": "0.1-3.9",
      "budgetedFrom": "Planned work - a standing percentage of engineering capacity",
      "documentation": "tiers/tier-3-best-practices.md"
    }
  ],

  "domains": [
    {
      "id": "network",
      "code": "NET",
      "name": "Network",
      "question": "What can be reached, and from where?",
      "typicalOwner": "Network engineering / cloud platform",
      "directory": "network/"
    },
    {
      "id": "iam",
      "code": "IAM",
      "name": "Identity & Access Management",
      "question": "Who can act, and how strongly is that proven?",
      "typicalOwner": "Identity engineering / IT operations",
      "directory": "identity-and-access-management/"
    },
    {
      "id": "data",
      "code": "DAT",
      "name": "Data Protection",
      "question": "What happens to the data if everything else fails?",
      "typicalOwner": "Data platform / application engineering",
      "directory": "data/"
    },
    {
      "id": "processing",
      "code": "PRC",
      "name": "Processing Protection",
      "question": "Is the compute that runs the business trustworthy and available?",
      "typicalOwner": "Platform engineering / SRE",
      "directory": "processing-protection/"
    }
  ],

  "classificationProcedure": {
    "documentation": "CLASSIFICATION.md",
    "rule": "Apply in order; stop at the first question answered yes.",
    "questions": [
      {
        "order": 1,
        "question": "Is it reachable by an untrusted party right now?",
        "ifNo": "Skip to question 3"
      },
      {
        "order": 2,
        "question": "Does exploitation grant access, privilege, or data without an unlikely chain of events?",
        "ifYes": "Tier 1",
        "ifNo": "Continue to question 3"
      },
      {
        "order": 3,
        "question": "Would a named auditor, regulator, or contractual counterparty record it as a deficiency?",
        "ifYes": "Tier 2",
        "ifNo": "Continue to question 4"
      },
      {
        "order": 4,
        "question": "Does fixing it reduce the number or severity of future Tier 1 and Tier 2 findings?",
        "ifYes": "Tier 3",
        "ifNo": "Not a Beacon finding"
      }
    ]
  },

  "findings": [
